# ---- Main -----------------------------------------------------------------

rm -f $tempFile $tempInputFile

echo
echo 
echo "---- Mini CD Manager ----"
sleep 1

quit=n
while [ "$quit" != "y" ]
do
	SetMenuChoice
	case "$menuChoice" in
		a) AddRecords;;
		r) RemoveRecords;;
		f) FindCD y;;
		u) UpdateCD;;
		c) CountCDs;;
		l) ListTracks;;
		q | Q) quit=y;;
		*) echo "Sorry, choice not recognized";;
	esac
done

rm -f $tempFile $tempInputFile
echo "Finished"
exit 0
